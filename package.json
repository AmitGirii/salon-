{
  "name": "cut-n-curl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cut N Curl — Salon & Aesthetic. Interactive 3D salon experience.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run typecheck && npm run test:camera",
    "test:camera": "esbuild tools/camera.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/camera.test.mjs --alias:@=./src --log-level=warning && node node_modules/.tmp/camera.test.mjs",
    "verify": "npm run test && npm run build",
    "package": "npm run build && node tools/package.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
